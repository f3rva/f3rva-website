# Production environment configuration
# Loaded when NODE_ENV=production or when running production builds
# Overrides values from .env and .env.development

# Production API URL
VITE_API_BASE_URL=https://api.f3rva.org

# Slack OpenID Connect Authentication
VITE_SLACK_CLIENT_ID=
VITE_SLACK_REDIRECT_URI=https://f3rva.org/auth/slack/callback